077  \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086 . \u1058 \u1086  \u1077 \u1089 \u1090 \u1100  \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086 , \u1082 \u1072 \u1082  \u1073 \u1099  \u1074 \u1089 \u1077  \u1088 \u1072 \u1074 \u1085 \u1086  \u1075 \u1086 \u1090 \u1086 \u1074 \u1086 . \u1044 \u1072 \u1083 \u1100 \u1096 \u1077  \u1087 \u1077 \u1088 \u1077 \u1081 \u1076 \u1091  \u1082  \u1073 \u1086 \u1090 \u1072  \u1073 \u1086 \u1083 \u1077 \u1077  \u1089 \u1083 \u1086 \u1078 \u1085 \u1086 \u1075 \u1086  \u1076 \u1083 \u1103  \u1082 \u1086 \u1084 \u1072 \u1085 \u1076  \u1088 \u1072 \u1079 \u1088 \u1072 \u1073 \u1086 \u1090 \u1082 \u1080 . \u1055 \u1088 \u1086 \u1094 \u1077 \u1089 \u1089  \u1074 \u1099 \u1089 \u1090 \u1088 \u1072 \u1080 \u1074 \u1072 \u1090 \u1100 . \u1058 \u1086  \u1077 \u1089 \u1090 \u1100  \u1075 \u1083 \u1086 \u1073 \u1072 \u1083 \u1100 \u1085 \u1086  \u1085 \u1072  Helmy \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \u1089 \u1090 \u1086 \u1080 \u1090  \u1072 \u1075 \u1077 \u1085 \u1090 , \u1087 \u1088 \u1086 \u1089 \u1090 \u1086  100 \u1073 \u1072 \u1082 \u1089 \u1086 \u1074  \u1087 \u1086 \u1076 \u1087 \u1080 \u1089 \u1082 \u1080 , \u1082 \u1086 \u1088 \u1086 \u1095 \u1077 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1099 \u1081  \u1084 \u1086 \u1078 \u1077 \u1090  \u1090 \u1072 \u1082 \u1080 \u1077  \u1079 \u1072 \u1076 \u1072 \u1095 \u1080  \u1074 \u1099 \u1087 \u1086 \u1083 \u1085 \u1103 \u1090 \u1100 . \u1042 \u1086 \u1090 . \u1044 \u1080 \u1084 , \u1090 \u1072 \u1084  \u1103  \u1087 \u1086  \u1093 \u1086 \u1076 \u1091  \u1088 \u1072 \u1079 \u1073 \u1086 \u1088 \u1086 \u1082  \u1089  \u1082 \u1086 \u1084 \u1087 \u1077 \u1096 \u1085 \u1099 \u1084  \u1087 \u1088 \u1086 \u1092 \u1080 \u1083 \u1077 \u1084  \u1087 \u1086 \u1085 \u1103 \u1083 , \u1095 \u1090 \u1086  \u1074 \u1086 \u1086 \u1073 \u1097 \u1077 , \u1074  \u1087 \u1088 \u1080 \u1085 \u1094 \u1080 \u1087 \u1077 , \u1101 \u1090 \u1080  \u1087 \u1088 \u1086 \u1092 \