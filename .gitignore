.DS_Store
.obsidian/workspace*
.obsidian/cache/
.basic-memory/
*.tmp

# MCP-серверы работы (project scope). В файле лежат токены доступа — в git он не идёт никогда:
# приватный репозиторий это не шифрование, и после ротации значение остаётся в истории.
.mcp.json

# Сырые логи агентских прогонов. Причина та же и найдена делом 06.08: в двух таких файлах
# лежало ПОЛНОЕ значение ключа платформы (60 символов, не префикс) — агент вывел его в
# диагностике, и лог осел в памяти. Заметки хранят префикс `phk_xxxxxxxx` как идентификатор,
# это безопасно; сырой лог хранит всё, что агент видел.
90-Materials/*.jsonl

# Выгрузки чужих репозиториев — это не наша память, а рабочая копия материала.
90-Materials/*.zip

# Лог ошибок ssh-manager — мусор рантайма, не память.
errors.log
